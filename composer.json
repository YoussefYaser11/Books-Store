{
  "name": "book-store/bud-library",
  "type": "project",
  "description": "Laravel conversion of the Arabic Book Store",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^2.10"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.24",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {"App\\\\": "app/"}
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\\\Foundation\\\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}